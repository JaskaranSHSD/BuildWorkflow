<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuildWorkflow</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuildWorkflow.styles.css" asp-append-version="true" />
</head>
<body>
@using BuildWorkflow.Data
@inject AppDbContext Db
@{
    var isLoginPage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Account", StringComparison.OrdinalIgnoreCase) &&
                      string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Login", StringComparison.OrdinalIgnoreCase);
    var brandName = "BuildWorkflow";
    if (User.Identity?.IsAuthenticated == true)
    {
        var orgClaim = User.FindFirst("OrganizationId")?.Value;
        if (Guid.TryParse(orgClaim, out var orgId))
        {
            var org = Db.Organizations.FirstOrDefault(o => o.Id == orgId);
            if (!string.IsNullOrWhiteSpace(org?.DisplayName)) brandName = org!.DisplayName!;
            else if (!string.IsNullOrWhiteSpace(org?.Name)) brandName = org!.Name;
        }
    }
}
@if (!isLoginPage)
{
<header class="app-header border-bottom bg-white">
    <div class="container-fluid px-4 py-2 d-flex justify-content-between align-items-center gap-2">
        <div class="app-brand">@brandName</div>
        <div class="d-flex align-items-center gap-2">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="text-muted" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-1"></i>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                </form>
            }
            else
            {
                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Login</a>
            }
        </div>
    </div>
</header>
}
<div class="app-layout @((User.Identity?.IsAuthenticated == true) ? "" : "no-sidebar")">
    @if (User.Identity?.IsAuthenticated == true)
    {
    <aside class="app-sidebar">
        @{
            var _sideUserId = Guid.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var _sid) ? _sid : Guid.Empty;
            var _sideUser = _sideUserId != Guid.Empty ? Db.Users.Find(_sideUserId) : null;
            var _sideAdmin = User.IsInRole("Admin") || User.IsInRole("OrgAdmin") || User.IsInRole("PlatformAdmin");
            var _canChat = _sideAdmin || (_sideUser != null && _sideUser.HasModulePermission(BuildWorkflow.Models.UserModulePermission.Chat));
            var _canWorkflow = _sideAdmin || (_sideUser != null && _sideUser.HasModulePermission(BuildWorkflow.Models.UserModulePermission.WorkflowsRead));
            var _canRag = _sideAdmin || (_sideUser != null && _sideUser.HasModulePermission(BuildWorkflow.Models.UserModulePermission.RagRead));
        }
        <nav class="app-nav">
            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Home</a>
            @if (_canChat) { <a class="nav-link" asp-area="" asp-controller="Chat" asp-action="Index"><i class="bi bi-chat-dots me-2"></i>Chat</a> }
            @if (_canWorkflow) { <a class="nav-link" asp-area="" asp-controller="Workflow" asp-action="Index"><i class="bi bi-diagram-3 me-2"></i>Workflow</a> }
            @if (_canWorkflow) { <a class="nav-link" asp-area="" asp-controller="Workflow" asp-action="Scheduled"><i class="bi bi-calendar-event me-2"></i>Scheduled Jobs</a> }
            @if (_canRag) { <a class="nav-link" asp-area="" asp-controller="KnowledgeSearch" asp-action="Index"><i class="bi bi-search me-2"></i>Knowledge Search</a> }
            <a class="nav-link" asp-area="" asp-controller="Help" asp-action="Index"><i class="bi bi-question-circle me-2"></i>Help</a>
            @if ((User.IsInRole("Admin") || User.IsInRole("OrgAdmin") || User.IsInRole("PlatformAdmin")))
            {
                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Models"><i class="bi bi-cpu me-2"></i>AI Models</a>
                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Tools"><i class="bi bi-tools me-2"></i>Tools</a>
                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="RagBuckets"><i class="bi bi-database me-2"></i>RAG Buckets</a>
                <a class="nav-link" asp-area="" asp-controller="Ollama" asp-action="Index"><i class="bi bi-rocket-takeoff me-2"></i>Ollama</a>
                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Users</a>
                @if (User.IsInRole("PlatformAdmin"))
                {
                    <a class="nav-link" asp-area="" asp-controller="PlatformAdmin" asp-action="Index"><i class="bi bi-buildings me-2"></i>Organizations</a>
    <a class="nav-link" asp-area="" asp-controller="System" asp-action="Index"><i class="bi bi-gear-wide-connected me-2"></i>System</a>
                }
            }
        </nav>
        <div class="app-sidebar-footer">
            &copy; 2026 - BuildWorkflow
        </div>
    </aside>
    }
    <div class="app-content">
        <main role="main" class="px-4 py-3">
            <div class="container-fluid px-4">
                @RenderBody()
            </div>
        </main>
    </div>
</div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        window.showAlert = function (message) {
            let modal = document.getElementById('globalAlertDialog');
            if (!modal) {
                modal = document.createElement('div');
                modal.id = 'globalAlertDialog';
                modal.className = 'modal fade';
                modal.tabIndex = -1;
                modal.innerHTML = '<div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Notice</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button></div></div></div>';
                document.body.appendChild(modal);
            }
            modal.querySelector('.modal-body').textContent = String(message ?? '');
            bootstrap.Modal.getOrCreateInstance(modal).show();
        };
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('input[required], select[required], textarea[required]').forEach(function (el) {
                var id = el.id;
                if (!id) return;
                var label = document.querySelector('label[for="' + id + '"]');
                if (label && !label.querySelector('.req-star')) {
                    var star = document.createElement('span');
                    star.className = 'text-danger req-star';
                    star.textContent = ' *';
                    label.appendChild(star);
                }
            });
            document.querySelectorAll('input[type="text"], input[type="search"], input[type="password"], textarea').forEach(function (el) {
                if (!el.hasAttribute('maxlength')) el.setAttribute('maxlength', '1000');
            });
            document.querySelectorAll('input[type="email"]').forEach(function (el) {
                if (!el.hasAttribute('maxlength')) el.setAttribute('maxlength', '254');
            });
            document.querySelectorAll('form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    var emailOk = true;
                    form.querySelectorAll('input[type="email"]').forEach(function (el) {
                        if (el.value && !/^[^\\s@@]+@@[^\\s@@]+\\.[^\\s@@]+$/.test(el.value)) emailOk = false;
                    });
                    if (!emailOk) { e.preventDefault(); alert('Please enter a valid email address.'); return false; }
                    if (!form.checkValidity()) { e.preventDefault(); form.reportValidity(); return false; }
                });
            });
        });
    </script>
</body>
</html>
