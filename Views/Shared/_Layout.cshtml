<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuildWorkflow</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BuildWorkflow.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">
        <aside class="app-sidebar">
            <div class="app-brand">BuildWorkflow</div>
            <nav class="app-nav">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-2"></i>Home</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-area="" asp-controller="Chat" asp-action="Index"><i class="bi bi-chat-dots me-2"></i>Chat</a>
                    <a class="nav-link" asp-area="" asp-controller="Workflow" asp-action="Index"><i class="bi bi-diagram-3 me-2"></i>Workflow</a>
                    if ((User.IsInRole("Admin") || User.IsInRole("OrgAdmin") || User.IsInRole("PlatformAdmin")))
                    {
                        <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Index"><i class="bi bi-gear me-2"></i>Admin</a>
                        @if (User.IsInRole("PlatformAdmin"))
                        {
                            <a class="nav-link" asp-area="" asp-controller="PlatformAdmin" asp-action="Index"><i class="bi bi-buildings me-2"></i>Organizations</a>
                        }
                    }
                }
                else
                {
                }
            </nav>
            <div class="app-sidebar-footer">
                &copy; 2026 - BuildWorkflow
            </div>
        </aside>
        <div class="app-content">
            <header class="border-bottom bg-white">
                <div class="container-fluid px-4 py-2 d-flex justify-content-end align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a class="text-muted" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle me-1"></i>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name)</a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Login</a>
                    }
                </div>
            </header>
            <main role="main" class="px-4 py-3">
                <div class="container-fluid px-4">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
