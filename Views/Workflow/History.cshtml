@{
    var workflowId = (Guid)ViewBag.WorkflowId;
    ViewData["Title"] = "Workflow History";
}
<style>
    .run-card { border-left: 4px solid #dee2e6; transition: box-shadow .15s ease, transform .15s ease; }
    .run-card.run-queued { border-left-color: #6c757d; }
    .run-card.run-running { border-left-color: #0d6efd; box-shadow: 0 0 0 .1rem rgba(13,110,253,.15); }
    .run-card.run-completed { border-left-color: #198754; }
    .run-card.run-failed { border-left-color: #dc3545; }
    .run-meta { font-size: .85rem; }
    .run-meta dt { color: #6c757d; font-weight: 500; }
    .run-meta dd { margin-bottom: .35rem; }
    .message-item { border-radius: .75rem; padding: .75rem; margin-bottom: .6rem; }
    .message-user { background: #e7f1ff; border: 1px solid #b6d4fe; }
    .message-assistant { background: #eaf6ee; border: 1px solid #b7e4c7; }
    .message-other { background: #f8f9fa; border: 1px solid #dee2e6; }
    .status-pill { font-size: .75rem; letter-spacing: .02em; }
    .empty-state { border: 1px dashed #dee2e6; border-radius: .75rem; }
</style>
<div class="container-fluid py-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <div>
            <h2 class="mb-0">Workflow Run History</h2>
            <p class="text-muted small mb-0" id="workflowSubtitle">Loading workflow details...</p>
            <div class="small text-muted mt-1" id="workflowMeta"></div>
        </div>
        <a href="/Workflow" class="btn btn-outline-secondary btn-sm">Back to Workflows</a>
    </div>

    <div id="workflowDetails" class="card border-primary mb-4 shadow-sm">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge text-bg-primary">Workflow</span>
                <strong id="workflowName">Loading...</strong>
            </div>
            <div class="row g-3 small">
                <div class="col-md-6">
                    <div class="text-muted">User instruction</div>
                    <div id="workflowUser" class="text-break">-</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted">System instruction</div>
                    <div id="workflowSystem" class="text-break">-</div>
                </div>
            </div>
        </div>
    </div>

    <div id="historyContent"></div>
</div>

<!-- Run details modal -->
<div class="modal fade" id="runDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="runDetailTitle">Run details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="runDetailBody">
                <div class="text-center text-muted py-4">Loading...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
const workflowId = '@workflowId';
let historyTimer = null;
const runsById = new Map();
let runsPage = 1;
const runsPageSize = 50;

async function api(path) {
    const response = await fetch(path);
    if (!response.ok) {
        const text = await response.text();
        const error = new Error(text || response.statusText);
        error.status = response.status;
        throw error;
    }
    return response;
}

function htmlEscape(value) {
    return String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
}

function formatDate(value) {
    if (!value) return '-';
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return htmlEscape(value);
    return date.toLocaleString([], {
        year: 'numeric', month: 'short', day: '2-digit',
        hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
}

function duration(start, end) {
    if (!start) return '-';
    const startDate = new Date(start);
    const endDate = end ? new Date(end) : new Date();
    if (Number.isNaN(startDate.getTime()) || Number.isNaN(endDate.getTime())) return '-';
    const seconds = Math.max(0, Math.round((endDate.getTime() - startDate.getTime()) / 1000));
    if (seconds < 60) return seconds + 's';
    const minutes = Math.floor(seconds / 60);
    const remaining = seconds % 60;
    return minutes + 'm ' + remaining + 's';
}

function statusBadge(status) {
    const normalized = (status || '').toLowerCase();
    const colors = {
        queued: 'text-bg-secondary',
        running: 'text-bg-primary',
        completed: 'text-bg-success',
        failed: 'text-bg-danger'
    };
    const color = colors[normalized] || 'text-bg-light';
    return '<span class="badge ' + color + ' status-pill">' + htmlEscape(status || 'Unknown') + '</span>';
}

function runStatusClass(status) {
    const normalized = (status || '').toLowerCase();
    return 'run-' + (['queued', 'running', 'completed', 'failed'].includes(normalized) ? normalized : 'queued');
}

function renderMessage(message, stepMap) {
    let role = (message.role || 'assistant').toLowerCase();
    let roleClass = 'message-other';
    if (role === 'user') roleClass = 'message-user';
    if (role === 'assistant') roleClass = 'message-assistant';
    const roleLabel = role === 'user' ? 'Workflow Context Request'
        : role === 'assistant' ? 'Assistant Response'
        : (message.role || 'assistant');
    let stepBadge = '';
    if (message.stepId && stepMap && stepMap.has(String(message.stepId))) {
        const stepInfo = stepMap.get(String(message.stepId));
        stepBadge = '<span class="badge text-bg-info me-2">Step ' + htmlEscape(stepInfo.order) + ': ' + htmlEscape(stepInfo.name || '') + '</span>';
    }
    let text = htmlEscape(message.content || '');
    text = text.replace(/file:([0-9a-fA-F-]{36})/g, function(match, fileId) {
        return '<a class="btn btn-sm btn-outline-success ms-2" href="/api/files/' + fileId + '/download">Download file</a>';
    });
    return '<div class="message-item ' + roleClass + '">' +
        '<div class="d-flex justify-content-between align-items-start mb-2">' +
            '<div>' + stepBadge + '<span class="fw-semibold">' + htmlEscape(roleLabel) + '</span></div>' +
            '<small class="text-muted ms-2">' + formatDate(message.createdAt) + '</small>' +
        '</div>' +
        '<div class="text-break">' + text + '</div>' +
    '</div>';
}

async function loadWorkflowDetails() {
    try {
        const response = await api('/api/workflow/' + workflowId);
        const data = await response.json();
        document.getElementById('workflowName').textContent = data.name || 'Workflow';
        document.getElementById('workflowSubtitle').textContent = 'Execution history and generated messages.';
        document.getElementById('workflowUser').textContent = data.userInstruction || '-';
        document.getElementById('workflowSystem').textContent = data.systemInstruction || '-';

        const scheduleTextPromise = (async () => {
            try {
                const schedules = await (await api('/api/workflow/' + workflowId + '/schedules')).json();
                if (Array.isArray(schedules) && schedules.length > 0) {
                    const next = schedules.filter(s => s.enabled && s.nextRunAt).map(s => s.nextRunAt).sort()[0];
                    return next ? 'Next: ' + formatDate(next) : 'Scheduled';
                }
                return 'Not scheduled';
            } catch {
                return 'Schedule unavailable';
            }
        })();

        const scheduleText = await scheduleTextPromise;
        const badge = (label, value, css) =>
            '<span class="badge ' + css + ' me-1 mb-1">' + htmlEscape(label) + ': ' + htmlEscape(value) + '</span>';

        document.getElementById('workflowMeta').innerHTML =
            badge('Schedule', scheduleText, scheduleText.startsWith('Next') ? 'text-bg-success' : 'text-bg-secondary');
    } catch (error) {
        document.getElementById('workflowName').textContent = 'Workflow';
        document.getElementById('workflowSubtitle').textContent = 'Could not load workflow details.';
    }
}

function renderRunCard(run) {
    runsById.set(String(run.id), run);
    return '<div class="card run-card ' + runStatusClass(run.status) + ' mb-3 shadow-sm">' +
        '  <div class="card-body">' +
        '    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">' +
        '      <div>' +
        '        <div class="d-flex align-items-center gap-2 flex-wrap mb-1">' +
        '          ' + statusBadge(run.status) +
        '          <span class="fw-semibold">Run ' + htmlEscape(String(run.id).substring(0, 8)) + '</span>' +
        '        </div>' +
        '        <small class="text-muted d-block">ID: ' + htmlEscape(run.id) + '</small>' +
        '      </div>' +
        '      <div class="text-end small run-meta">' +
        '        <div><strong>Duration:</strong> ' + duration(run.startedAt, run.completedAt) + '</div>' +
        '        <div><strong>Model:</strong> ' + htmlEscape(run.modelId || 'default') + '</div>' +
        '      </div>' +
        '    </div>' +
        '    <dl class="row run-meta mb-2">' +
        '      <dt class="col-sm-3">Created</dt><dd class="col-sm-9">' + formatDate(run.createdAt) + '</dd>' +
        '      <dt class="col-sm-3">Started</dt><dd class="col-sm-9">' + formatDate(run.startedAt) + '</dd>' +
        '      <dt class="col-sm-3">Completed</dt><dd class="col-sm-9">' + formatDate(run.completedAt) + '</dd>' +
        '      <dt class="col-sm-3">Session</dt><dd class="col-sm-9">' + htmlEscape(run.sessionId || '-') + '</dd>' +
        '    </dl>' +
        (run.error ? '    <div class="alert alert-danger small mb-2"><strong>Error:</strong> ' + htmlEscape(run.error) + '</div>' : '') +
        '    <div class="d-flex justify-content-end">' +
        '      <button class="btn btn-sm btn-outline-primary" onclick="openRunDetails(\'' + run.id + '\')">View details & log</button>' +
        '    </div>' +
        '  </div>' +
        '</div>';
}

async function openRunDetails(runId) {
    const modal = new bootstrap.Modal(document.getElementById('runDetailModal'));
    const title = document.getElementById('runDetailTitle');
    const body = document.getElementById('runDetailBody');

    const run = runsById.get(String(runId));
    title.textContent = 'Run ' + String(runId).substring(0, 8) + ' details';
    body.innerHTML = '<div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm me-2"></div>Loading execution log...</div>';
    modal.show();

    let runHtml = '';
    if (run) {
        runHtml = '<dl class="row small mb-3">' +
            '<dt class="col-sm-3">Status</dt><dd class="col-sm-9">' + statusBadge(run.status) + '</dd>' +
            '<dt class="col-sm-3">Run ID</dt><dd class="col-sm-9 text-break">' + htmlEscape(run.id) + '</dd>' +
            '<dt class="col-sm-3">Created</dt><dd class="col-sm-9">' + formatDate(run.createdAt) + '</dd>' +
            '<dt class="col-sm-3">Started</dt><dd class="col-sm-9">' + formatDate(run.startedAt) + '</dd>' +
            '<dt class="col-sm-3">Completed</dt><dd class="col-sm-9">' + formatDate(run.completedAt) + '</dd>' +
            '<dt class="col-sm-3">Duration</dt><dd class="col-sm-9">' + duration(run.startedAt, run.completedAt) + '</dd>' +
            '<dt class="col-sm-3">Model</dt><dd class="col-sm-9">' + htmlEscape(run.modelId || 'default') + '</dd>' +
            '<dt class="col-sm-3">Session</dt><dd class="col-sm-9">' + htmlEscape(run.sessionId || '-') + '</dd>' +
            '</dl>' +
            (run.error ? '<div class="alert alert-danger small"><strong>Error:</strong> ' + htmlEscape(run.error) + '</div>' : '');
    }

    const stepMap = new Map();
    let stepsHtml = '';
    try {
        const stepsResponse = await api('/api/workflow/runs/' + runId + '/steps');
        const steps = await stepsResponse.json();
        if (Array.isArray(steps)) {
            steps.forEach(step => stepMap.set(String(step.id), { order: step.order, name: step.stepName, status: step.status }));
            stepsHtml = '<h6 class="mt-3">Steps executed</h6><div class="list-group mb-3">' +
                steps.map(step =>
                    '<div class="list-group-item d-flex justify-content-between align-items-center">' +
                        '<div><span class="badge text-bg-secondary me-2">Step ' + htmlEscape(step.order) + '</span>' + htmlEscape(step.stepName || 'Unnamed step') + '</div>' +
                        '<span class="badge ' + (step.status === 'Completed' ? 'text-bg-success' : step.status === 'Failed' ? 'text-bg-danger' : 'text-bg-secondary') + '">' + htmlEscape(step.status || 'Unknown') + '</span>' +
                    '</div>'
                ).join('') + '</div>';
        }
    } catch (error) {
        // If step metadata is unavailable, continue with the execution log.
    }

    try {
        const response = await api('/api/workflow/runs/' + runId + '/messages');
        const messages = await response.json();
        let messagesHtml = '';
        if (Array.isArray(messages) && messages.length > 0) {
            messagesHtml = messages.map(message => renderMessage(message, stepMap)).join('');
        } else {
            messagesHtml = '<div class="text-muted small fst-italic">No messages recorded for this run.</div>';
        }
        body.innerHTML = runHtml + stepsHtml + '<h6 class="mt-3">Execution log</h6>' + messagesHtml;
    } catch (error) {
        let message = 'Execution log could not be loaded.';
        if (error.status === 401 || error.status === 403 || error.status === 404) {
            message = 'You are not allowed to view this execution log.';
        }
        body.innerHTML = runHtml + stepsHtml + '<div class="alert alert-warning small mb-0">' + htmlEscape(message) + '</div>';
    }
}

async function loadRuns(page) {
    runsPage = page || runsPage || 1;
    try {
        if (historyTimer) {
            clearTimeout(historyTimer);
            historyTimer = null;
        }

        const response = await api('/api/workflow/' + workflowId + '/runs?page=' + runsPage + '&pageSize=' + runsPageSize);
        const pageRuns = await response.json();
        const runs = Array.isArray(pageRuns) ? pageRuns : [];
        runs.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

        const totalCount = parseInt(response.headers.get('X-Total-Count') || String(runs.length), 10) || runs.length;
        const totalPages = Math.max(1, Math.ceil(totalCount / runsPageSize));

        if (runs.length === 0) {
            document.getElementById('historyContent').innerHTML =
                '<div class="empty-state p-4 text-center text-muted">No workflow runs yet. Start one from the Workflows page.</div>' +
                renderRunsPagination(totalCount, totalPages, runsPage);
            return;
        }

        document.getElementById('historyContent').innerHTML =
            '<div class="d-flex justify-content-between align-items-center mb-2 small text-muted">' +
                '<span>Total records: ' + htmlEscape(totalCount) + '</span>' +
                '<span>Page ' + htmlEscape(runsPage) + ' of ' + htmlEscape(totalPages) + '</span>' +
            '</div>' +
            runs.map(renderRunCard).join('') +
            renderRunsPagination(totalCount, totalPages, runsPage);

        const hasActive = runs.some(run => run.status === 'Queued' || run.status === 'Running');
        if (hasActive) {
            historyTimer = setTimeout(() => loadRuns(runsPage), 3000);
        }
    } catch (error) {
        console.error(error);
        document.getElementById('historyContent').innerHTML =
            '<div class="alert alert-danger">History failed: ' + htmlEscape(error && error.message ? error.message : error) + '</div>';
    }
}

function renderRunsPagination(totalCount, totalPages, currentPage) {
    if (totalPages <= 1) return '';
    let html = '<nav class="mt-3"><ul class="pagination pagination-sm justify-content-center">';
    html += '<li class="page-item ' + (currentPage <= 1 ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="gotoRunsPage(' + (currentPage - 1) + ');return false;">Previous</a></li>';
    for (let p = 1; p <= totalPages; p++) {
        html += '<li class="page-item ' + (p === currentPage ? 'active' : '') + '"><a class="page-link" href="#" onclick="gotoRunsPage(' + p + ');return false;">' + p + '</a></li>';
    }
    html += '<li class="page-item ' + (currentPage >= totalPages ? 'disabled' : '') + '"><a class="page-link" href="#" onclick="gotoRunsPage(' + (currentPage + 1) + ');return false;">Next</a></li>';
    html += '</ul></nav>';
    return html;
}

function gotoRunsPage(page) {
    if (!page || page < 1) return;
    loadRuns(page);
}

document.addEventListener('DOMContentLoaded', function() {
    loadWorkflowDetails();
    loadRuns(1);
});
</script>
