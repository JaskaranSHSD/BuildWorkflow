@{
    ViewData["Title"] = "Workflows";
}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Workflows</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createWorkflowModal">Create workflow</button>
  </div>

  <div class="modal fade" id="createWorkflowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Create Workflow</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <label class="form-label">Workflow Name <span class="text-danger">*</span></label>
          <input id="wfName" class="form-control mb-2" placeholder="Name" required />
          <div class="form-text mb-2">Required workflow name.</div>
          <label class="form-label">Description</label>
          <textarea id="wfDescription" class="form-control mb-2" placeholder="Description (optional)"></textarea>
          <div class="form-text mb-2">Optional short description.</div>
          <label class="form-label">System Instruction</label>
          <textarea id="wfSystem" class="form-control mb-2" placeholder="System instruction (optional)"></textarea>
          <div class="form-text mb-2">Optional system-level guidance.</div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-success" onclick="createWorkflow()">Save</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="editWorkflowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Edit Workflow</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="editWfId" />
          <label class="form-label">Workflow Name <span class="text-danger">*</span></label>
          <input id="editWfName" class="form-control mb-2" placeholder="Name" required />
          <label class="form-label">Description</label>
          <textarea id="editWfDescription" class="form-control mb-2" placeholder="Description (optional)"></textarea>
          <label class="form-label">System Instruction</label>
          <textarea id="editWfSystem" class="form-control mb-2" placeholder="System instruction (optional)"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-success" onclick="updateWorkflow()">Save</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="shareWorkflowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Share Workflow</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="shareWfId" />
          <div class="row g-2 mb-3">
            <div class="col-md-9">
              <select id="shareUserSelect" class="form-select"></select>
            </div>
            <div class="col-md-3">
              <button type="button" class="btn btn-primary w-100" onclick="shareWorkflow()">Share</button>
            </div>
          </div>
          <div id="shareList"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="scheduleWorkflowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Schedule Workflow</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="scheduleWfId" />
          <div class="mb-2">
            <label class="form-label">Schedule pattern</label>
            <select id="scheduleType" class="form-select" onchange="toggleScheduleFields()">
              <option value="once">Run once</option>
              <option value="interval">Repeat every N minutes</option>
              <option value="daily">Daily</option>
              <option value="weekly">Weekly (selected weekdays)</option>
              <option value="monthlyDay">Monthly (day of month)</option>
              <option value="monthlyNth">Monthly (nth weekday, e.g. 1st Monday)</option>
              <option value="monthlyLastDay">Monthly (last day of month)</option>
            </select>
          </div>

          <div class="mb-2" id="scheduleDateTimeGroup">
            <label class="form-label">Start date &amp; time</label>
            <input id="scheduleDateTime" type="datetime-local" class="form-control" />
            <div class="form-text">Used as the first run for one-off schedules, or as the starting anchor/time-of-day for recurring patterns.</div>
          </div>

          <div class="mb-2 d-none" id="scheduleIntervalGroup">
            <label class="form-label">Repeat every (minutes)</label>
            <input id="scheduleIntervalMinutes" type="number" class="form-control" value="60" min="1" />
          </div>

          <div class="mb-2 d-none" id="scheduleTimeGroup">
            <label class="form-label">Time of day (hour:minute)</label>
            <div class="d-flex gap-2">
              <input id="scheduleHour" type="number" class="form-control" min="0" max="23" value="9" />
              <input id="scheduleMinute" type="number" class="form-control" min="0" max="59" value="0" />
            </div>
          </div>

          <div class="mb-2 d-none" id="scheduleWeekDaysGroup">
            <label class="form-label">Weekdays</label>
            <div class="d-flex flex-wrap gap-2">
              <div class="form-check"><input class="form-check-input sched-dow" type="checkbox" value="1" id="schedDow1"><label class="form-check-label" for="schedDow1">Mon</label></div>
              <div class="form-check"><input class="form-check-input sched-dow" type="checkbox" value="2" id="schedDow2"><label class="form-check-label" for="schedDow2">Tue</label></div>
              <div class="form-check"><input class="form-check-input sched-dow" type="checkbox" value="3" id="schedDow3"><label class="form-check-label" for="schedDow3">Wed</label></div>
              <div class="form-check"><input class="form-check-input sched-dow" type="checkbox" value="4" id="schedDow4"><label class="form-check-label" for="schedDow4">Thu</label></div>
              <div class="form-check"><input class="form-check-input sched-dow" type="checkbox" value="5" id="schedDow5"><label class="form-check-label" for="schedDow5">Fri</label></div>
              <div class="form-check"><input class="form-check-input sched-dow" type="checkbox" value="6" id="schedDow6"><label class="form-check-label" for="schedDow6">Sat</label></div>
              <div class="form-check"><input class="form-check-input sched-dow" type="checkbox" value="0" id="schedDow0"><label class="form-check-label" for="schedDow0">Sun</label></div>
            </div>
          </div>

          <div class="mb-2 d-none" id="scheduleMonthDayGroup">
            <label class="form-label">Day of month (1-31)</label>
            <input id="scheduleDayOfMonth" type="number" class="form-control" min="1" max="31" value="1" />
            <div class="form-text">If the month has fewer days, the last day of that month is used.</div>
          </div>

          <div class="mb-2 d-none" id="scheduleMonthNthGroup">
            <label class="form-label">Week of month + weekday</label>
            <div class="d-flex gap-2">
              <select id="scheduleWeekOfMonth" class="form-select">
                <option value="1">1st</option>
                <option value="2">2nd</option>
                <option value="3">3rd</option>
                <option value="4">4th</option>
                <option value="5">Last</option>
              </select>
              <select id="scheduleDowSingle" class="form-select">
                <option value="1">Monday</option>
                <option value="2">Tuesday</option>
                <option value="3">Wednesday</option>
                <option value="4">Thursday</option>
                <option value="5">Friday</option>
                <option value="6">Saturday</option>
                <option value="0">Sunday</option>
              </select>
            </div>
          </div>

          <div class="mb-2 d-none" id="scheduleEndGroup">
            <label class="form-label">End at (optional)</label>
            <input id="scheduleEndAt" type="datetime-local" class="form-control" />
          </div>

          <div id="scheduleList" class="mt-3"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" class="btn btn-primary" onclick="createSchedule()">Save Schedule</button>
        </div>
      </div>
    </div>
  </div>

  <div class="mb-3">
    <input type="search" id="wf-search" class="form-control" placeholder="Search workflows by name or description…" aria-label="Search workflows" />
  </div>
  <div id="list"></div>
</div>

<script>
async function api(path, opts){ return fetch(path, Object.assign({headers:{'Content-Type':'application/json'}}, opts)); }

async function createWorkflow(){
  const body = {name: document.getElementById('wfName').value, description: document.getElementById('wfDescription').value, systemInstruction: document.getElementById('wfSystem').value};
  const r = await api('/api/workflow', {method:'POST', body: JSON.stringify(body)});
  if(!r.ok){ showAlert(await r.text()); return; }
  document.getElementById('wfName').value = '';
  document.getElementById('wfDescription').value = '';
  document.getElementById('wfSystem').value = '';
  const modalEl = document.getElementById('createWorkflowModal');
  const modal = bootstrap.Modal.getInstance(modalEl);
  if (modal) modal.hide();
  load(1);
}

async function editWorkflow(id){
  const r = await api('/api/workflow/'+id);
  if(!r.ok){ showAlert(await r.text()); return; }
  const w = await r.json();
  document.getElementById('editWfId').value = w.id;
  document.getElementById('editWfName').value = w.name || '';
  document.getElementById('editWfDescription').value = w.description || '';
  document.getElementById('editWfSystem').value = w.systemInstruction || '';
  const modal = new bootstrap.Modal(document.getElementById('editWorkflowModal'));
  modal.show();
}

async function updateWorkflow(){
  const id = document.getElementById('editWfId').value;
  const body = {
    name: document.getElementById('editWfName').value,
    description: document.getElementById('editWfDescription').value,
    systemInstruction: document.getElementById('editWfSystem').value
  };
  const r = await api('/api/workflow/'+id, {method:'PUT', body: JSON.stringify(body)});
  if(!r.ok){ showAlert(await r.text()); return; }
  const modalEl = document.getElementById('editWorkflowModal');
  const modal = bootstrap.Modal.getInstance(modalEl);
  if (modal) modal.hide();
  load(1);
}

async function loadShareUsers() {
  const r = await api('/api/users');
  if (!r.ok) return [];
  return await r.json();
}

async function loadShares(id) {
  const r = await api('/api/workflow/' + id + '/shares');
  if (!r.ok) return [];
  return await r.json();
}

async function openShare(id) {
  document.getElementById('shareWfId').value = id;
  const users = await loadShareUsers();
  const select = document.getElementById('shareUserSelect');
  select.innerHTML = '';
  for (const u of users) {
    const option = document.createElement('option');
    option.value = u.id;
    option.textContent = (u.fullName && u.fullName !== u.username) ? u.fullName + ' (' + u.username + ')' : u.username;
    select.appendChild(option);
  }
  await renderShares(id);
  const modal = new bootstrap.Modal(document.getElementById('shareWorkflowModal'));
  modal.show();
}

async function renderShares(id) {
  const shares = await loadShares(id);
  const container = document.getElementById('shareList');
  if (!shares.length) {
    container.innerHTML = '<div class="text-muted small fst-italic">Not shared with anyone yet.</div>';
    return;
  }
  let html = '<table class="table table-sm"><thead><tr><th>User</th><th>Permission</th><th></th></tr></thead><tbody>';
  for (const s of shares) {
    html += '<tr><td>' + (s.fullName || s.userName) + '</td><td>' + s.permission + '</td><td><button class="btn btn-sm btn-danger" type="button" onclick="revokeShare(\'' + id + '\',\'' + s.id + '\')">Revoke</button></td></tr>';
  }
  html += '</tbody></table>';
  container.innerHTML = html;
}

async function shareWorkflow() {
  const id = document.getElementById('shareWfId').value;
  const userId = document.getElementById('shareUserSelect').value;
  const r = await api('/api/workflow/' + id + '/shares', { method: 'POST', body: JSON.stringify({ userId }) });
  if (!r.ok) { showAlert(await r.text()); return; }
  await renderShares(id);
}

async function revokeShare(id, shareId) {
  const r = await api('/api/workflow/' + id + '/shares/' + shareId, { method: 'DELETE' });
  if (!r.ok) { showAlert(await r.text()); return; }
  await renderShares(id);
}

function toggleScheduleFields() {
  const type = document.getElementById('scheduleType').value;
  const show = (id, cond) => {
    const el = document.getElementById(id);
    if (!el) return;
    if (cond) el.classList.remove('d-none'); else el.classList.add('d-none');
  };
  show('scheduleIntervalGroup', type === 'interval');
  show('scheduleTimeGroup', ['daily','weekly','monthlyDay','monthlyNth','monthlyLastDay'].includes(type));
  show('scheduleWeekDaysGroup', type === 'weekly');
  show('scheduleMonthDayGroup', type === 'monthlyDay');
  show('scheduleMonthNthGroup', type === 'monthlyNth');
  show('scheduleEndGroup', type !== 'once');
}

async function loadSchedules(id) {
  const r = await api('/api/workflow/' + id + '/schedules');
  if (!r.ok) return [];
  return await r.json();
}

async function renderSchedules(id) {
  const schedules = await loadSchedules(id);
  const container = document.getElementById('scheduleList');
  if (!schedules.length) {
    container.innerHTML = '<div class="text-muted small fst-italic">No schedules yet.</div>';
    return;
  }
  let html = '<table class="table table-sm"><thead><tr><th>Pattern</th><th>Next run</th><th></th></tr></thead><tbody>';
  for (const s of schedules) {
    const enabled = s.enabled ? 'Enabled' : 'Disabled';
    const pattern = (s.scheduleType || 'Once') + (s.intervalMinutes ? ' / ' + s.intervalMinutes + 'm' : '');
    html += '<tr><td>' + pattern + '</td><td>' + (s.nextRunAt || s.runAt || '-') + ' (' + enabled + ')</td><td><button class="btn btn-sm btn-danger" type="button" onclick="deleteSchedule(\'' + id + '\',\'' + s.id + '\')">Delete</button></td></tr>';
  }
  html += '</tbody></table>';
  container.innerHTML = html;
}

async function openSchedule(id) {
  document.getElementById('scheduleWfId').value = id;
  document.getElementById('scheduleType').value = 'once';
  toggleScheduleFields();
  document.getElementById('scheduleDateTime').value = '';
  document.getElementById('scheduleIntervalMinutes').value = 60;
  document.getElementById('scheduleHour').value = 9;
  document.getElementById('scheduleMinute').value = 0;
  document.querySelectorAll('.sched-dow').forEach(cb => cb.checked = false);
  document.getElementById('scheduleDayOfMonth').value = 1;
  document.getElementById('scheduleWeekOfMonth').value = 1;
  document.getElementById('scheduleDowSingle').value = 1;
  document.getElementById('scheduleEndAt').value = '';
  await renderSchedules(id);
  const modal = new bootstrap.Modal(document.getElementById('scheduleWorkflowModal'));
  modal.show();
}

async function createSchedule() {
  const id = document.getElementById('scheduleWfId').value;
  const type = document.getElementById('scheduleType').value;
  const dateTimeValue = document.getElementById('scheduleDateTime').value;
  const runAt = dateTimeValue ? new Date(dateTimeValue).toISOString() : null;
  const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

  let scheduleType = 'Once';
  let intervalMinutes = null;
  let daysOfWeek = null;
  let dayOfMonth = null;
  let weekOfMonth = null;
  let dayOfWeek = null;
  let hour = null;
  let minute = null;
  let endAt = null;

  const endVal = document.getElementById('scheduleEndAt').value;
  if (endVal) endAt = new Date(endVal).toISOString();

  if (type === 'interval') {
    scheduleType = 'Interval';
    intervalMinutes = Number(document.getElementById('scheduleIntervalMinutes').value || 60);
  } else if (type === 'daily') {
    scheduleType = 'Daily';
    hour = Number(document.getElementById('scheduleHour').value || 9);
    minute = Number(document.getElementById('scheduleMinute').value || 0);
  } else if (type === 'weekly') {
    scheduleType = 'Weekly';
    const selected = Array.from(document.querySelectorAll('.sched-dow:checked')).map(cb => cb.value);
    daysOfWeek = selected.join(',');
    hour = Number(document.getElementById('scheduleHour').value || 9);
    minute = Number(document.getElementById('scheduleMinute').value || 0);
  } else if (type === 'monthlyDay') {
    scheduleType = 'MonthlyDay';
    dayOfMonth = Number(document.getElementById('scheduleDayOfMonth').value || 1);
    hour = Number(document.getElementById('scheduleHour').value || 9);
    minute = Number(document.getElementById('scheduleMinute').value || 0);
  } else if (type === 'monthlyNth') {
    scheduleType = 'MonthlyNth';
    weekOfMonth = Number(document.getElementById('scheduleWeekOfMonth').value || 1);
    dayOfWeek = Number(document.getElementById('scheduleDowSingle').value || 1);
    hour = Number(document.getElementById('scheduleHour').value || 9);
    minute = Number(document.getElementById('scheduleMinute').value || 0);
  } else if (type === 'monthlyLastDay') {
    scheduleType = 'MonthlyLastDay';
    hour = Number(document.getElementById('scheduleHour').value || 9);
    minute = Number(document.getElementById('scheduleMinute').value || 0);
  } else {
    scheduleType = 'Once';
  }

  const body = {
    scheduleType,
    runAt,
    intervalMinutes,
    daysOfWeek,
    dayOfMonth,
    weekOfMonth,
    dayOfWeek,
    hour,
    minute,
    timeZoneId: timeZone,
    endAt,
    cronExpression: null
  };

  const r = await api('/api/workflow/' + id + '/schedule', { method: 'POST', body: JSON.stringify(body) });
  if (!r.ok) { showAlert(await r.text()); return; }
  await renderSchedules(id);
}

async function deleteSchedule(workflowId, scheduleId) {
  const r = await api('/api/workflow/schedules/' + scheduleId, { method: 'DELETE' });
  if (!r.ok) { showAlert(await r.text()); return; }
  await renderSchedules(workflowId);
}

function showStartedModal(message) {
  let element = document.getElementById('runStartedModal');
  if (!element) {
    element = document.createElement('div');
    element.id = 'runStartedModal';
    element.className = 'modal fade';
    element.tabIndex = -1;
    element.innerHTML = '<div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">Workflow status</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">OK</button></div></div></div>';
    document.body.appendChild(element);
  }
  element.querySelector('.modal-body').textContent = message;
  const modal = new bootstrap.Modal(element);
  modal.show();
}

async function runNow(id, button){
  if (button) {
    button.disabled = true;
    button.dataset.originalText = button.innerHTML;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Starting...';
  }
  let runId = null;
  try {
    const r = await api('/api/workflow/'+id+'/run', {method:'POST'});
    if (!r.ok) throw new Error(await r.text());
    const d = await r.json();
    runId = d.runId;
    if (button) {
      button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Running...';
      button.classList.remove('btn-primary');
      button.classList.add('btn-secondary');
    }
    showStartedModal('Workflow started. Run queued: ' + runId);
  } catch (error) {
    showStartedModal('Could not start workflow: ' + (error && error.message ? error.message : error));
    if (button) {
      button.disabled = false;
      button.innerHTML = button.dataset.originalText || 'Run';
      button.classList.remove('btn-secondary');
      button.classList.add('btn-primary');
    }
    return;
  }
  load(1);
  setTimeout(() => {
    if (button) {
      button.disabled = false;
      button.innerHTML = button.dataset.originalText || 'Run';
      button.classList.remove('btn-secondary');
      button.classList.add('btn-primary');
    }
  }, 3000);
}

let allWorkflows = [];
let wfPage = 1;
let wfTotalPages = 1;
let wfTotalCount = 0;
const wfPageSize = 10;
let wfSearch = '';
async function load(page){
  wfPage = page || wfPage || 1;
  const r = await fetch('/api/workflow?page=' + wfPage + '&pageSize=' + wfPageSize + '&search=' + encodeURIComponent(wfSearch), { headers: { 'Content-Type': 'application/json' } });
  allWorkflows = await r.json();
  wfTotalCount = parseInt(r.headers.get('X-Total-Count') || String(allWorkflows.length), 10) || allWorkflows.length;
  wfTotalPages = Math.max(1, Math.ceil(wfTotalCount / wfPageSize));
  if (wfPage > wfTotalPages) wfPage = wfTotalPages;
  if (wfPage < 1) wfPage = 1;
  renderWorkflows();
}
function renderWorkflows(){
  let html = '<div class="small text-muted mb-2">Total records: ' + wfTotalCount + '</div><table class="table align-middle"><thead><tr><th>Workflow</th><th>Steps</th><th>Runs</th><th>Actions</th></tr></thead><tbody>';
  for (const w of allWorkflows) {
    let actionButtons = '';
    actionButtons += '<a class="btn btn-sm btn-outline-secondary me-1" href="/Workflow/Manage?id=' + w.id + '">Manage</a>';
    html += '<tr>';
    html += '<td><strong>' + htmlSafe(w.name) + '</strong></td>';
    html += '<td>' + (w.stepCount || 0) + '</td>';
    html += '<td>' + (w.runCount || 0) + '</td>';
    html += '<td>' + actionButtons + '</td>';
    html += '</tr>';
  }
  html += '</tbody></table>';
  if (wfTotalPages > 1) {
    html += '<nav class="mt-3"><ul class="pagination">';
    for (let p = 1; p <= wfTotalPages; p++) {
      html += '<li class="page-item ' + (p === wfPage ? 'active' : '') + '"><a class="page-link" href="#" onclick="gotoWfPage(' + p + ');return false;">' + p + '</a></li>';
    }
    html += '</ul></nav>';
  }
  document.getElementById('list').innerHTML = html;
}
function gotoWfPage(p){
  if (!p || p < 1 || p > wfTotalPages) return;
  load(p);
}

function htmlSafe(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}
const wfSearchInput = document.getElementById('wf-search');
let wfSearchTimer = null;
if (wfSearchInput) {
    wfSearchInput.addEventListener('input', function() {
        clearTimeout(wfSearchTimer);
        wfSearchTimer = setTimeout(function() {
            wfSearch = wfSearchInput.value.trim();
            load(1);
        }, 300);
    });
}
load(1);
</script>


