@model List<BuildWorkflow.Models.Organization>
@{
    ViewData["Title"] = "Organizations";
    var counts = ViewBag.UserCounts as Dictionary<Guid,int> ?? new Dictionary<Guid,int>();
}
<h2 class="mb-3">Organizations</h2>

<div class="card mb-4">
    <div class="card-body">
        <form asp-controller="PlatformAdmin" asp-action="CreateOrganization" method="post" class="row g-2">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <input name="name" class="form-control" placeholder="Organization name" required />
            </div>
            <div class="col-md-3">
                <input name="slug" class="form-control" placeholder="Slug (optional)" />
            </div>
            <div class="col-md-3">
                <input name="displayName" class="form-control" placeholder="Topbar/login name (optional)" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">Create Organization</button>
            </div>
        </form>
    </div>
</div>

<form method="get" asp-controller="PlatformAdmin" asp-action="Index" class="mb-3">
    <div class="input-group">
        <input type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search organizations by name…" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>
<p class="small text-muted mb-2">Total records: @(ViewBag.TotalCount ?? 0)</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Users</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var org in Model)
        {
            <tr>
                <td>@org.Name</td>
                <td>@org.Slug</td>
                <td>@(counts.TryGetValue(org.Id, out var c) ? c : 0)</td>
                <td>@org.IsActive</td>
                <td>
                    <a class="btn btn-sm btn-outline-secondary me-1" asp-controller="PlatformAdmin" asp-action="EditOrganization" asp-route-id="@org.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-primary" asp-controller="PlatformAdmin" asp-action="ManageOrganization" asp-route-id="@org.Id">Manage</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@if ((int)(ViewBag.TotalPages ?? 1) > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-controller="PlatformAdmin" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search">@p</a>
                </li>
            }
        </ul>
    </nav>
}