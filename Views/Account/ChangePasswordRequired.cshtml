@{
    ViewData["Title"] = "Change Password Required";
}
<div class="login-shell">
    <div class="login-card">
        <h1 class="login-title">Change password required</h1>
        <p class="login-subtitle">Your account requires a new password before continuing.</p>
        @if (TempData["ProfileError"] != null)
        {
            <div class="alert alert-danger small">@TempData["ProfileError"]</div>
        }
        <form asp-action="ChangePasswordRequired" method="post" class="login-form">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label login-label" for="newPassword">New Password</label>
                <input type="password" id="newPassword" name="newPassword" class="form-control login-input" required pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}" title="Password must be at least 8 characters and include uppercase, lowercase, number, and special character." />
            </div>
            <div class="mb-3">
                <label class="form-label login-label" for="confirmPassword">Confirm Password</label>
                <input type="password" id="confirmPassword" name="confirmPassword" class="form-control login-input" required pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}" title="Password must be at least 8 characters and include uppercase, lowercase, number, and special character." />
            </div>
            <button type="submit" class="btn btn-primary login-button w-100">Update Password</button>
        </form>
    </div>
</div>