@{
    ViewData["Title"] = "Assign RAG Buckets";
    var users = ViewBag.Users as List<BuildWorkflow.Models.AppUser> ?? new();
    var buckets = ViewBag.Buckets as List<BuildWorkflow.Models.RagBucket> ?? new();
    var groups = ViewBag.KnowledgeGroups as List<BuildWorkflow.Models.KnowledgeGroup> ?? new();
    var assignments = ViewBag.Assignments as List<BuildWorkflow.Models.UserRagBucket> ?? new();
}
<div class="card p-3">
    <h2>Assign RAG Buckets to Users</h2>
    <form asp-action="AssignRagBucket" method="post" class="row g-2 mb-3">
        <div class="col-md-4">
            <select name="userId" class="form-select">
                @foreach (var u in users) { <option value="@u.Id">@u.Username</option> }
            </select>
        </div>
        <div class="col-md-4">
            <select name="bucketId" class="form-select">
                @foreach (var b in buckets) { <option value="@b.Id">@b.Name</option> }
            </select>
        </div>
        <div class="col-md-4"><button class="btn btn-primary w-100">Assign Bucket</button></div>
    </form>
    <form asp-action="AssignRagBucketGroup" method="post" class="row g-2 mb-3">
        <div class="col-md-4">
            <select name="userId" class="form-select">
                @foreach (var u in users) { <option value="@u.Id">@u.Username</option> }
            </select>
        </div>
        <div class="col-md-4">
            <select name="knowledgeGroupId" class="form-select">
                @foreach (var g in groups) { <option value="@g.Id">@g.Name</option> }
            </select>
        </div>
        <div class="col-md-4"><button class="btn btn-outline-primary w-100">Assign Knowledge Group</button></div>
    </form>
    <table class="table table-sm">
        <thead><tr><th>User</th><th>RAG Bucket</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in assignments)
        {
            <tr>
                <td>@a.User.Username</td>
                <td>@a.RagBucket.Name</td>
                <td>
                    <form asp-action="UnassignRagBucket" method="post">
                        <input type="hidden" name="id" value="@a.Id" />
                        <button class="btn btn-sm btn-danger">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary mt-2">Back to Dashboard</a>
</div>