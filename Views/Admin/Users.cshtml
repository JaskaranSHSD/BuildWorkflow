@model List<BuildWorkflow.Models.AppUser>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Users</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">Create User</button>
</div>
<form method="get" asp-action="Users" class="mb-3">
    <div class="input-group">
        <input type="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search users by name or description…" />
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Create User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-2"><input name="Username" class="form-control" placeholder="Username" /></div>
                    <div class="mb-2"><input name="FullName" class="form-control" placeholder="Full name" /></div>
                    <div class="mb-2"><input name="Email" class="form-control" placeholder="Email" /></div>
                    <div class="mb-2"><input name="Password" class="form-control" placeholder="Password" required pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}" title="Password must be at least 8 characters and include uppercase, lowercase, number, and special character." /></div>
                    <div class="mb-2">
                        <select name="Role" class="form-select">
                            <option value="User">User</option>
                            <option value="Admin">Admin</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table class="table">
    <thead><tr><th>Username</th><th>Full name</th><th>Email</th><th>Role</th><th>Status</th><th>Created</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Username</td>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Role</td>
            <td>@(item.IsActive ? "Active" : "Inactive")</td>
            <td>@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                <a asp-action="ManageUser" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">Manage</a>
                @if (!string.Equals(item.Username, "admin", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-action="DeleteUser" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<p class="small text-muted mb-2">Total records: @(ViewBag.TotalCount ?? 0)</p>
@if ((int)(ViewBag.TotalPages ?? 1) > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var p = 1; p <= (int)ViewBag.TotalPages; p++)
            {
                <li class="page-item @(p == (int)ViewBag.Page ? "active" : "")">
                    <a class="page-link" asp-action="Users" asp-route-page="@p" asp-route-search="@ViewBag.Search">@p</a>
                </li>
            }
        </ul>
    </nav>
}
<a asp-action="Index" class="btn btn-secondary">Back</a>
