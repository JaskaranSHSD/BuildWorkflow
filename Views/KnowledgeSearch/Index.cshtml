@{
    ViewData["Title"] = "Knowledge Search";
    var buckets = ViewBag.Buckets as List<BuildWorkflow.Models.RagBucket> ?? new List<BuildWorkflow.Models.RagBucket>();
}
<div class="container-fluid">
    <h2>Knowledge Search</h2>
    <p class="text-muted">Select knowledge buckets, enter a question, and search the indexed content.</p>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Knowledge Buckets
                    <button type="button" class="btn btn-sm btn-link float-end" onclick="toggleKnowledgeBuckets(true)">All</button>
                    <button type="button" class="btn btn-sm btn-link float-end" onclick="toggleKnowledgeBuckets(false)">None</button>
                </div>
                <div class="card-body" style="max-height:400px;overflow:auto;">
                    @foreach (var b in buckets)
                    {
                        <div class="form-check">
                            <input class="form-check-input knowledge-bucket" type="checkbox" value="@b.Id" id="kb-@b.Id" checked />
                            <label class="form-check-label" for="kb-@b.Id">@b.Name</label>
                        </div>
                    }
                    @if (buckets.Count == 0)
                    {
                        <div class="text-muted">No knowledge buckets available.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="mb-2">
                <textarea id="knowledgeQuery" class="form-control" rows="3" placeholder="What are you looking for?"></textarea>
            </div>
            <button class="btn btn-primary" onclick="searchKnowledge()">Search</button>
            <div id="knowledgeResults" class="mt-3"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleKnowledgeBuckets(state) {
  document.querySelectorAll('.knowledge-bucket').forEach(cb => cb.checked = state);
}
async function searchKnowledge() {
  const query = document.getElementById('knowledgeQuery').value.trim();
  if (!query) { showAlert('Enter a query.'); return; }
  const bucketIds = Array.from(document.querySelectorAll('.knowledge-bucket:checked')).map(cb => cb.value);
  const r = await fetch('/api/knowledge/search', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query, bucketIds })
  });
  if (!r.ok) { showAlert(await r.text()); return; }
  const hits = await r.json();
  const container = document.getElementById('knowledgeResults');
  if (!hits || hits.length === 0) {
    container.innerHTML = '<div class="alert alert-warning">No results found.</div>';
    return;
  }
  container.innerHTML = hits.map((h, i) => `
    <div class="card mb-2">
      <div class="card-body">
        <div class="small text-muted mb-1">Result ${i+1} (score: ${Number(h.score).toFixed(3)})</div>
        <div style="white-space:pre-wrap;">${escapeHtml(h.content)}</div>
      </div>
    </div>
  `).join('');
}
function escapeHtml(value) {
  return String(value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
}