@{
    ViewData["Title"] = "Chat";
    var chatModels = ViewBag.Models as List<BuildWorkflow.Models.AiModelDefinition> ?? new();
    var defaultModel = chatModels.FirstOrDefault();
    var ragBuckets = ViewBag.RagBuckets as List<BuildWorkflow.Models.RagBucket> ?? new();
    var tools = ViewBag.Tools as List<BuildWorkflow.Models.ToolDefinition> ?? new();
}
<style>
    .tool-group-tree {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .tool-group {
        background: #ffffff;
        border: 1px solid #e6e8eb;
        border-radius: 18px;
        box-shadow: 0 1px 3px rgba(60, 64, 67, 0.08);
        padding: 0.75rem;
    }
    .tool-group-summary {
        list-style: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        padding: 0.15rem 0.1rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: #202124;
    }
    .tool-group-summary::-webkit-details-marker {
        display: none;
    }
    .tool-group-summary::before {
        content: "›";
        margin-right: 0.55rem;
        color: #5f6368;
        font-size: 1.25rem;
        line-height: 1;
        transition: transform 0.2s ease;
    }
    .tool-group[open] .tool-group-summary::before {
        transform: rotate(90deg);
    }
    .tool-group-name {
        letter-spacing: 0.01em;
    }
    .tool-group-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.6rem;
        height: 1.6rem;
        padding: 0 0.45rem;
        border-radius: 999px;
        background: #f1f3f4;
        color: #5f6368;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .selection-grid {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        margin-top: 0.65rem;
    }
    .selection-tile {
        position: relative;
    }
    .selection-tile-input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    .selection-tile-label {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        text-align: left;
        width: 100%;
        min-height: 2.6rem;
        padding: 0.6rem 0.85rem;
        border: 1px solid #dadce0;
        border-radius: 12px;
        background: #ffffff;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        color: #202124;
        box-shadow: 0 1px 2px rgba(60,64,67,0.08);
        transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease, transform 0.12s ease;
    }
    .selection-tile-check {
        width: 18px;
        height: 18px;
        border: 1.5px solid #dadce0;
        border-radius: 4px;
        margin-right: 0.6rem;
        flex: 0 0 18px;
        background: #fff;
    }
    .selection-tile-input:checked + .selection-tile-label {
        border-color: #1e8e3e;
        background: #e6f4ea;
        color: #137333;
        box-shadow: 0 1px 2px rgba(26,115,232,0.12);
    }
    .selection-tile-input:checked + .selection-tile-label .selection-tile-check {
        background: #1e8e3e;
        border-color: #1e8e3e;
    }
    .selection-tile-label:hover {
        background: #e8eaed;
        transform: translateY(-1px);
    }
    .selection-tile-input:checked + .selection-tile-label {
        border-color: #1e8e3e;
        background: #e6f4ea;
        color: #137333;
        box-shadow: 0 1px 2px rgba(26, 115, 232, 0.12);
    }
    .selection-tile-input:focus-visible + .selection-tile-label {
        outline: 2px solid #1a73e8;
        outline-offset: 2px;
    }
    .selection-tile-input:disabled + .selection-tile-label {
        opacity: 0.55;
        cursor: not-allowed;
        transform: none;
    }
    .selection-tile-name {
        line-height: 1.2;
        word-break: break-word;
    }
    .selection-tile-check {
        display: none;
    }
</style>
<div class="chatgpt-shell">
    <aside class="chatgpt-sidebar">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">Chats</h5>
            <button id="new-chat" class="btn btn-sm btn-outline-secondary" type="button">New</button>
        </div>
        <ul id="chat-history" class="list-group list-group-flush flex-grow-1 overflow-auto"></ul>
    </aside>

    <main class="chatgpt-main">
        <div id="chat-log" class="chatgpt-log"></div>
        <div class="chatgpt-composer">
            <small id="file-status" class="text-muted d-block mb-2"></small>
            <div class="d-flex flex-wrap gap-2 align-items-center border rounded p-2 mb-2">
                <input id="chat-input" type="text" class="form-control border-0 shadow-none" placeholder="Message BuildWorkflow..." />
                <input id="file-input" type="file" class="form-control" multiple accept="@((ViewBag.AllowedFileExtensions as string) ?? "")" @(string.IsNullOrWhiteSpace(ViewBag.AllowedFileExtensions as string) ? "disabled" : "") style="max-width: 220px;" />
                @if (string.IsNullOrWhiteSpace(ViewBag.AllowedFileExtensions as string))
                {
                    <small class="text-muted d-block">File uploads are disabled by policy.</small>
                }
            <input id="image-input" type="file" accept="image/*" class="form-control" style="max-width: 220px; display:none;" />
        @if (chatModels.Count >= 1)
        {
            <select id="modelSelect" class="form-select form-select-sm" style="max-width: 200px;" title="Model">
                @foreach (var m in chatModels)
                {
                    <option value="@m.Id" data-supports-tools="@m.SupportsTools.ToString().ToLowerInvariant()" data-supports-images="@m.SupportsImages.ToString().ToLowerInvariant()">@m.Name</option>
                }
            </select>
        }
        else if (defaultModel != null)
        {
            <input type="hidden" id="modelSelect" value="@defaultModel.Id" data-supports-tools="@defaultModel.SupportsTools.ToString().ToLowerInvariant()" data-supports-images="@defaultModel.SupportsImages.ToString().ToLowerInvariant()" />
        }
                <button id="chat-send" class="btn btn-primary" type="button">Send</button>
                <span id="chat-progress" class="spinner-border spinner-border-sm text-primary ms-2" style="display:none;" aria-hidden="true"></span>
                <span id="chat-progress-text" class="small text-muted ms-2" style="display:none;">Workingâ€¦</span>
            </div>
        </div>
    </main>

    <aside class="chatgpt-right">
        <h5 class="mb-2">Selection</h5>
        <div class="mb-3">
            <div class="fw-semibold small mb-2">Tools</div>
            @{
                var toolGroups = tools
                    .GroupBy(t => string.IsNullOrWhiteSpace(t.ToolGroup?.Name) ? "General" : t.ToolGroup!.Name)
                    .OrderBy(g => g.Key);
            }
            <div class="tool-group-list">
                @foreach (var group in toolGroups)
                {
                    var toolPanelId = "tool-panel-" + @group.Key.Replace(" ", "-");
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 mb-2 tool-group-open" data-panel="@toolPanelId" data-title="@group.Key tools">
                        <span>@group.Key</span>
                        <span class="badge text-bg-light border ms-2 group-count-badge" data-panel="@toolPanelId">0/@group.Count()</span>
                    </button>
                }
            </div>
        </div>
        <div class="mb-3">
            <div class="fw-semibold small mb-2">Knowledge</div>
            @{
                var knowledgeGroups = ragBuckets
                    .GroupBy(b => string.IsNullOrWhiteSpace(b.KnowledgeGroup?.Name) ? "General" : b.KnowledgeGroup!.Name)
                    .OrderBy(g => g.Key);
            }
            <div class="tool-group-list">
                @foreach (var group in knowledgeGroups)
                {
                    var knowledgePanelId = "knowledge-panel-" + @group.Key.Replace(" ", "-");
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100 mb-2 tool-group-open" data-panel="@knowledgePanelId" data-title="@group.Key knowledge">
                        <span>@group.Key</span>
                        <span class="badge text-bg-light border ms-2 group-count-badge" data-panel="@knowledgePanelId">0/@group.Count()</span>
                    </button>
                }
            </div>
        </div>
    </aside>

    <div id="selection-store" style="display:none;">
        @foreach (var group in toolGroups)
        {
            var toolPanelId = "tool-panel-" + @group.Key.Replace(" ", "-");
            <div class="selection-panel" id="@toolPanelId" data-title="@group.Key tools">
                <div class="selection-grid mt-2">
                    @foreach (var t in group)
                    {
                        <div class="selection-tile">
                            <input class="selection-tile-input chat-tool" type="checkbox" value="@t.Id" id="chat-tool-@t.Id" checked />
                            <label class="selection-tile-label" for="chat-tool-@t.Id">
                                <span class="selection-tile-check" aria-hidden="true"></span>
                                <span class="selection-tile-name">@t.Name</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
        @foreach (var group in knowledgeGroups)
        {
            var knowledgePanelId = "knowledge-panel-" + @group.Key.Replace(" ", "-");
            <div class="selection-panel" id="@knowledgePanelId" data-title="@group.Key knowledge">
                <div class="selection-grid mt-2">
                    @foreach (var b in group)
                    {
                        <div class="selection-tile">
                            <input class="selection-tile-input chat-knowledge" type="checkbox" value="@b.Id" id="chat-knowledge-@b.Id" checked />
                            <label class="selection-tile-label" for="chat-knowledge-@b.Id">
                                <span class="selection-tile-check" aria-hidden="true"></span>
                                <span class="selection-tile-name">@b.Name</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="modal fade" id="selectionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="selectionModalTitle">Selection</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="selectionModalBody"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Done</button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
    const log = document.getElementById('chat-log');
    const input = document.getElementById('chat-input');
    const send = document.getElementById('chat-send');
    const modelSelect = document.getElementById('modelSelect');
    const fileInput = document.getElementById('file-input');
    const imageInput = document.getElementById('image-input');
    const fileStatus = document.getElementById('file-status');
    const historyList = document.getElementById('chat-history');
    const maxUploadSize = @(ViewBag.MaxUploadSizeBytes ?? 10485760);
    if (fileInput) {
        fileInput.addEventListener('change', function() {
            for (const file of Array.from(fileInput.files || [])) {
                if (maxUploadSize && file.size > maxUploadSize) {
                    showAlert('File is too large: ' + file.name + ' (max ' + maxUploadSize + ' bytes).');
                    fileInput.value = '';
                    return;
                }
                const allowed = (fileInput.accept || '').split(',').map(x => x.trim().toLowerCase()).filter(Boolean);
                const ext = ('.' + (file.name.split('.').pop() || '')).toLowerCase();
                if (allowed.length > 0 && !allowed.includes(ext)) {
                    showAlert('File type is not allowed: ' + file.name);
                    fileInput.value = '';
                    return;
                }
            }
        });
    }

        const uploadSessionKey = (crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).slice(2));
    let currentSessionId = null;

    const dropZone = document.querySelector('.chatgpt-main') || document.body;
    if (dropZone) {
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                dropZone.classList.add('chat-drop-active');
            });
        });
        ['dragleave', 'dragend'].forEach(eventName => {
            dropZone.addEventListener(eventName, (e) => {
                e.preventDefault();
                e.stopPropagation();
                if (e.target === dropZone) dropZone.classList.remove('chat-drop-active');
            });
        });
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            e.stopPropagation();
            dropZone.classList.remove('chat-drop-active');
            const droppedFiles = Array.from(e.dataTransfer?.files || []);
            if (!droppedFiles.length) return;
            const droppedImageCount = droppedFiles.filter(f => (f.type || '').startsWith('image/')).length;
            const droppedFileCount = droppedFiles.length - droppedImageCount;
            if (droppedImageCount > 2 || droppedFileCount > 2) {
                fileStatus.textContent = 'You can attach at most 2 files and 2 images per chat message.';
                return;
            }
            const caps = selectedModelCapabilities();
            const accepted = [];
            const rejected = [];
            droppedFiles.forEach(file => {
                if (file.type.startsWith('image/') && !caps.supportsImages) {
                    rejected.push(file.name + ' (model does not support images)');
                } else {
                    accepted.push(file);
                }
            });
            if (rejected.length) {
                fileStatus.textContent = 'Skipped: ' + rejected.join(', ');
            }
            if (!accepted.length) return;
            const dataTransfer = new DataTransfer();
            accepted.forEach(file => dataTransfer.items.add(file));
            if (fileInput) fileInput.files = dataTransfer.files;
            fileStatus.textContent = 'Dropped: ' + accepted.map(f => f.name).join(', ') + '. Press Send to attach.';
        });
    }

    function append(role, text, attachedFileIds) {
        const div = document.createElement('div');
        div.className = 'chat-message ' + (role === 'Assistant' ? 'assistant' : 'user');
        const meta = document.createElement('div');
        meta.className = 'chat-message-meta';
        meta.textContent = role;
        const body = document.createElement('div');
        body.className = 'chat-message-body';
        const tokenPattern = /file:[0-9a-fA-F-]{36}/g;
        let lastIndex = 0;
        function renderInlineMarkdown(content) {
            const escaped = String(content)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');
            const rendered = escaped
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/`([^`]+)`/g, '<code>$1</code>')
                .replace(/\n/g, '<br>');
            const span = document.createElement('span');
            span.innerHTML = rendered;
            body.appendChild(span);
        }
        for (const match of text.matchAll(tokenPattern)) {
            if (match.index > lastIndex) {
                renderInlineMarkdown(text.slice(lastIndex, match.index));
            }
            const fileId = match[0].slice(5);
            const link = document.createElement('a');
            link.href = '/api/files/' + fileId + '/download';
            link.textContent = 'Download generated file';
            link.className = 'd-block mt-1';
            body.appendChild(link);
            lastIndex = match.index + match[0].length;
        }
        if (lastIndex < text.length) {
            renderInlineMarkdown(text.slice(lastIndex));
        }
        if (attachedFileIds && Array.isArray(attachedFileIds) && attachedFileIds.length) {
            attachedFileIds.forEach(id => {
                const link = document.createElement('a');
                link.href = '/api/files/' + id + '/download';
                link.textContent = 'Download attached file';
                link.className = 'd-block mt-1';
                body.appendChild(link);
            });
        }
        div.appendChild(meta);
        div.appendChild(body);
        log.appendChild(div);
        requestAnimationFrame(() => {
            log.scrollTop = log.scrollHeight;
        });
    }

    function labelForRole(role) {
        return role === 'assistant' ? 'Assistant' : 'You';
    }

    async function loadSessions() {
        try {
            const res = await fetch('/api/chat/sessions?page=1&pageSize=10');
            if (!res.ok) return;
            const sessions = await res.json();
            historyList.innerHTML = '';
            sessions.forEach(s => {
                const item = document.createElement('li');
                item.className = 'list-group-item list-group-item-action border-0 rounded mb-1';
                item.textContent = s.title || 'New chat';
                item.addEventListener('click', () => loadSession(s.id));
                if (currentSessionId && s.id === currentSessionId) {
                    item.classList.add('active');
                }
                historyList.appendChild(item);
            });
        } catch (err) {
            console.log(err);
        }
    }

    async function loadSession(id) {
        currentSessionId = id;
        log.innerHTML = '';
        try {
            const res = await fetch('/api/chat/sessions/' + id + '/messages');
            if (!res.ok) {
                let error = 'This chat has reached its message limit. Please start a new chat.';
                try { const data = await res.json(); if (data.error) error = data.error; } catch { }
                currentSessionId = null;
                append('Error', error);
                return;
            }
            const messages = await res.json();
            messages.forEach(m => { const ids = m.attachedFileIds ? String(m.attachedFileIds).split(",").map(x => x.trim()).filter(Boolean) : []; append(labelForRole(m.role), m.content, ids); });
            requestAnimationFrame(() => { log.scrollTop = log.scrollHeight; });
        } catch (err) {
            console.log(err);
        }
        await loadSessions();
    }

    async function sendChatMessage(message, attachedFileIds) {
        if (!message && !(attachedFileIds && attachedFileIds.length)) return;
        append('You', message || 'Sent attached file(s).', attachedFileIds || []);
        send.disabled = true;
        input.disabled = true;
        const progress = document.getElementById('chat-progress');
        const progressText = document.getElementById('chat-progress-text');
        if (progress) progress.style.display = 'inline-block';
        if (progressText) progressText.style.display = 'inline';
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 180000);
        try {
            const res = await fetch('/api/chat/stream', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                signal: controller.signal,
                body: JSON.stringify({ message: message || 'Please use the attached file(s).', modelId: modelSelect ? modelSelect.value : null, attachedFileIds, sessionId: currentSessionId, ragBucketId: null, selectedToolIds: Array.from(document.querySelectorAll('.chat-tool:checked')).map(cb => cb.value), selectedRagBucketIds: Array.from(document.querySelectorAll('.chat-knowledge:checked')).map(cb => cb.value) })
            });
            if (!res.ok) {
                let data = null;
                try { data = await res.json(); } catch { }
                append('Error', (data && data.error) ? data.error : 'Request failed');
            } else {
                const assistantDiv = document.createElement('div');
                assistantDiv.className = 'chat-message assistant';
                const meta = document.createElement('div');
                meta.className = 'chat-message-meta';
                meta.textContent = 'Assistant';
                const body = document.createElement('div');
                body.className = 'chat-message-body';
                assistantDiv.appendChild(meta);
                assistantDiv.appendChild(body);
                log.appendChild(assistantDiv);
                body.innerHTML = '<span class="chat-thinking" aria-label="Thinking"><span></span><span></span><span></span></span>';
                let accumulated = '';
                const reader = res.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    buffer += decoder.decode(value, { stream: true });
                    const parts = buffer.split('\n\n');
                    buffer = parts.pop() || '';
                    for (const part of parts) {
                        const lines = part.split('\n');
                        for (const line of lines) {
                            if (!line.startsWith('data:')) continue;
                            const payload = line.slice(5).trim();
                            if (!payload) continue;
                            try {
                                const chunk = JSON.parse(payload);
                                if (chunk.Error) { append('Error', chunk.Error); return; }
                                if (chunk.Delta) {
                                    accumulated += chunk.Delta;
                                    body.innerHTML = accumulated
                                        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                                        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                                        .replace(/\*(.+?)\*/g, '<em>$1</em>')
                                        .replace(/`([^`]+)`/g, '<code>$1</code>')
                                        .replace(/\n/g, '<br>');
                                }
                                if (chunk.SessionId) currentSessionId = chunk.SessionId;
                                if (chunk.Done) await loadSessions();
                            } catch { }
                        }
                    }
                    requestAnimationFrame(() => { log.scrollTop = log.scrollHeight; });
                }
            }
        } catch (err) {
            if (err && err.name === 'AbortError') {
                append('Error', 'Request timed out after 3 minutes. Try a smaller file or prompt.');
            } else {
                append('Error', String(err));
            }
        } finally {
            clearTimeout(timeoutId);
            send.disabled = false;
            input.disabled = false;
            const progress = document.getElementById('chat-progress');
            const progressText = document.getElementById('chat-progress-text');
            if (progress) progress.style.display = 'none';
            if (progressText) progressText.style.display = 'none';
            input.focus();
        }
    }

    function selectedModelCapabilities() {
        if (!modelSelect) return { supportsTools: true, supportsImages: false };
        let element = modelSelect;
        let option = null;
        if (element.tagName === 'SELECT') option = element.options[element.selectedIndex];
        const data = option ? option.dataset : element.dataset;
        return {
            supportsTools: (data.supportsTools || 'true') === 'true',
            supportsImages: (data.supportsImages || 'false') === 'true'
        };
    }

    function applyModelCapabilities() {
        const caps = selectedModelCapabilities();
        document.querySelectorAll('.chat-tool').forEach(cb => {
            cb.disabled = !caps.supportsTools;
            cb.checked = caps.supportsTools;
        });
        if (imageInput) {
            imageInput.style.display = caps.supportsImages ? '' : 'none';
            if (!caps.supportsImages) imageInput.value = '';
        }
    }

    async function uploadOne(file) {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('sessionKey', uploadSessionKey);
        const res = await fetch('/api/files/upload', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? 'Upload failed.');
        return data;
    }

    async function sendMessage() {
        const message = input.value.trim();
        const files = [];
        if (fileInput.files) Array.from(fileInput.files).forEach(f => files.push(f));
        if (imageInput && imageInput.files) Array.from(imageInput.files).forEach(f => files.push(f));
        let ids = [];

        const imageCount = files.filter(f => (f.type || '').startsWith('image/')).length;
        const fileCount = files.length - imageCount;
        if (imageCount > 2 || fileCount > 2) {
            if (fileInput) fileInput.value = '';
            if (imageInput) imageInput.value = '';
            fileStatus.textContent = 'You can attach at most 2 files and 2 images per chat message.';
            return;
        }

        if (files.length) {
            fileStatus.textContent = 'Uploading...';
            try {
                for (const file of files) {
                    const data = await uploadOne(file);
                    ids.push(data.fileId);
                }
                fileStatus.textContent = 'Attached: ' + files.map(f => f.name).join(', ');
                if (fileInput) fileInput.value = '';
                if (imageInput) imageInput.value = '';
            } catch (err) {
                fileStatus.textContent = String(err);
                return;
            }
        }

        if (!message && !ids.length) return;
        input.value = '';
        const chatMessage = ids.length
            ? (message ? message + '\n\nAttached: ' + files.map(f => f.name).join(', ') : 'Attached: ' + files.map(f => f.name).join(', '))
            : message;
        await sendChatMessage(chatMessage, ids);
    }

    document.getElementById('new-chat').addEventListener('click', () => {
        currentSessionId = null;
        log.innerHTML = '';
        input.focus();
        loadSessions();
    });

    if (modelSelect && modelSelect.tagName === 'SELECT') {
        modelSelect.addEventListener('change', applyModelCapabilities);
    }
    applyModelCapabilities();
    send.addEventListener('click', sendMessage);
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') sendMessage(); });
    loadSessions();
let currentSelectionPanel = null;
const selectionModalEl = document.getElementById('selectionModal');
const selectionModal = selectionModalEl ? new bootstrap.Modal(selectionModalEl) : null;
const selectionModalBody = document.getElementById('selectionModalBody');
const selectionModalTitle = document.getElementById('selectionModalTitle');
document.querySelectorAll('.tool-group-open').forEach(btn => {
    btn.addEventListener('click', () => {
        if (currentSelectionPanel) {
            const store = document.getElementById('selection-store');
            if (store) store.appendChild(currentSelectionPanel);
        }
        const panel = document.getElementById(btn.dataset.panel);
        if (!panel) return;
        currentSelectionPanel = panel;
        if (selectionModalTitle) selectionModalTitle.textContent = btn.dataset.title || 'Selection';
        if (selectionModalBody) selectionModalBody.appendChild(panel);
        selectionModal?.show();
    });
});
selectionModalEl?.addEventListener('hidden.bs.modal', () => {
    if (currentSelectionPanel) {
        const store = document.getElementById('selection-store');
        if (store) store.appendChild(currentSelectionPanel);
        currentSelectionPanel = null;
    }
});
function updateGroupCount(panelId) {
    const panel = document.getElementById(panelId);
    const badge = document.querySelector('.group-count-badge[data-panel="' + panelId + '"]');
    if (!panel || !badge) return;
    const boxes = Array.from(panel.querySelectorAll('input.chat-tool, input.chat-knowledge'));
    const selected = boxes.filter(b => b.checked).length;
    badge.textContent = selected + '/' + boxes.length;
}
function updateAllGroupCounts() {
    document.querySelectorAll('.group-count-badge').forEach(badge => updateGroupCount(badge.dataset.panel));
}
document.addEventListener('change', function(e) {
    if (e.target && (e.target.matches('input.chat-tool') || e.target.matches('input.chat-knowledge'))) {
        const panel = e.target.closest('.selection-panel');
        if (panel) updateGroupCount(panel.id);
    }
});
document.addEventListener('DOMContentLoaded', function() {
    updateAllGroupCounts();
});

</script>
}